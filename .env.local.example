# Copy to .env.local and fill in your values.

# ArcGIS OAuth application (client) ID. Register an app at https://developer.arcgis.com
# and add http://localhost:5173 as a redirect URI.
VITE_ARCGIS_OAUTH_APP_ID=

# Portal URL (leave default for ArcGIS Online).
VITE_PORTAL_URL=https://www.arcgis.com

# WebMap item ID containing the 3000m hex-bin layer with emb_0..emb_255 fields.
VITE_WEBMAP_ITEM_ID=

# Optional: exact title of the hex-bin layer in the WebMap.
# If omitted, the first FeatureLayer with an emb_0 field is used.
VITE_HEX_LAYER_TITLE=

# Optional: exact title of the demographics hex layer in the WebMap. This layer
# holds the human-readable risk/demographic fields the assistant describes.
VITE_DEMOGRAPHICS_LAYER_TITLE=

# Optional: field shared by both hex layers, used to join a selected hex to its
# demographics. Leave empty to match on ObjectID (when the IDs line up).
VITE_HEX_KEY_FIELD=

# MCP hub base URL (served through the Vite dev proxy).
VITE_MCP_BASE_URL=/api/mcp
